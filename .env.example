# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used ONLY for account deletion and the receipt-retention cleanup job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used in auth email redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI: receipt vision + voice interpretation (server-only) ---
# Supported: anthropic | none
AI_VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# --- Speech-to-text (server-only) ---
# Supported: openai | none   (when none, the browser's speech recognition or typed input is used)
AI_TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Voice interpretation strategy: auto (rules first, AI only when unsure) | rules | ai
VOICE_PARSER=auto

# Per-user hourly limits for paid AI calls
AI_RATE_LIMIT_SCANS_PER_HOUR=30
AI_RATE_LIMIT_TRANSCRIPTIONS_PER_HOUR=60

# Protects /api/cron/cleanup (receipt retention). Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me
